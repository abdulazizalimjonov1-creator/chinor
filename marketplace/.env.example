# YesPOS marketplace gateway
YESPOS_BASE_URL=https://marketplace.yestask.uz/api/v1
YESPOS_API_KEY=bu-yerga-kalitni-yoz
YESPOS_BRANCH=1
YESPOS_APP_NAME=YesPOS

# Ixtiyoriy
# DATA_DIR=/var/lib/chinor
# TZ_OFFSET_HOURS=5
# DEAD_STOCK_DAYS=30
# OUT_OF_STOCK_DAYS=7

# ── Telegram userbot (YesPOS chek xabarlarini o'qish) ──────────────────────
# my.telegram.org → API development tools dan olinadi. api_hash MAXFIY.
TG_API_ID=
TG_API_HASH=
# Sessiya fayli yo'li (kengaytmasiz). Bu fayl akkauntga to'liq kalit:
# huquqi 600, git'ga tushmaydi, zaxira nusxaga qo'shilmaydi.
TG_SESSION=
# Chek yuboradigan bot, masalan @yespos_bot — `dialogs` buyrug'i topadi.
YESPOS_BOT=

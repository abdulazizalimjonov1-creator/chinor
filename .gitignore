# Maxfiy — hech qachon GitHubga chiqmasin
.env
*.env
.env.*
!.env.example

# Claude Code lokal sozlamalari (sirlar bo'lishi mumkin)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
env/
.venv/

# Runtime ma'lumotlar — kod daraxtidan tashqarida (DATA_DIR, default: data/)
# pos.db, uploads/, exports/, backups/ shu yerda; git'ga CHIQMAYDI
data/

# SQLite baza (mahalliy ma'lumotlar)
*.db
*.db-shm
*.db-wal
*.db.bak*

# Yuklangan rasmlar
uploads/

# macOS
.DS_Store

# Wrangler / Cloudflare
.wrangler/

# Logs
*.log

# Export fayllar va arxivlar
exports/
*.zip
*.xlsx

# Backup fayllar
*.bak
*_backup.*

# Electron desktop ilovalari (yig'ilgan fayllar — qayta yasaladi)
desktop/node_modules/
desktop/dist/
desktop-admin/node_modules/
desktop-admin/dist/
# (node_modules symlink bo'lishi ham mumkin — trailing slashsiz)
chinor-kassa/node_modules
chinor-kassa/dist/
chinor-admin/node_modules
chinor-admin/dist/

# Build artefaktlar (qayta yasaladi — git'da saqlanmaydi)
*.tgz
*.exe
*.blockmap

# Marketplace integratsiyasi
marketplace/.env
data/marketplace.db*
data/marketplace-images/

# Telegram userbot sessiyasi — akkauntga kalit, HECH QACHON git.ga tushmasin
data/tg_userbot*
*.session
*.session-journal

# Desktop yangilanish fayllari — build natijasi (165 MB), git'da saqlanmaydi.
# Faqat `latest*.yml` kuzatiladi: u kichik va qaysi versiya chiqarilganini
# ko'rsatib turadi.
chinor-bot/updates/**/*.exe
chinor-bot/updates/**/*.zip
chinor-bot/updates/**/*.blockmap
chinor-bot/updates/**/*.dmg
